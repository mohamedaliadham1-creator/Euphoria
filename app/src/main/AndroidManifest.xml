<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name="com.example.euphoria.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.EuphoriaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 1. Compact Widget -->
        <receiver
            android:name=".widget.EuphoriaCompactWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.euphoria.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.euphoria.widget.ACTION_NEXT" />
                <action android:name="com.example.euphoria.widget.ACTION_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <!-- 2. Premium Widget -->
        <receiver
            android:name=".widget.EuphoriaPremiumWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.euphoria.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.euphoria.widget.ACTION_NEXT" />
                <action android:name="com.example.euphoria.widget.ACTION_PREV" />
                <action android:name="com.example.euphoria.widget.ACTION_FAV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_premium_info" />
        </receiver>

        <!-- 3. Minimal Widget -->
        <receiver
            android:name=".widget.EuphoriaMinimalWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.euphoria.widget.ACTION_PLAY_PAUSE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_minimal_info" />
        </receiver>

        <!-- 4. Artwork Widget -->
        <receiver
            android:name=".widget.EuphoriaArtworkWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.euphoria.widget.ACTION_PLAY_PAUSE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_artwork_info" />
        </receiver>

        <!-- 5. Extended Widget -->
        <receiver
            android:name=".widget.EuphoriaExtendedWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.euphoria.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.example.euphoria.widget.ACTION_NEXT" />
                <action android:name="com.example.euphoria.widget.ACTION_PREV" />
                <action android:name="com.example.euphoria.widget.ACTION_SHUFFLE" />
                <action android:name="com.example.euphoria.widget.ACTION_REPEAT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_extended_info" />
        </receiver>

    </application>

</manifest>
